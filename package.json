{
  "name": "aiarr",
  "version": "1.0.0",
  "description": "OpenAI-powered chatbot for media server management",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run mcp\" \"npm run client\"",
    "server": "nodemon backend/server.js",
    "mcp": "nodemon backend/mcp-server.js",
    "client": "cd frontend && npm run dev",
    "install-all": "npm install && cd frontend && npm install",
    "build": "cd frontend && npm run build"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "node-fetch": "^3.3.2",
    "openai": "^4.28.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.19",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
